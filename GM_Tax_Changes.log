. 
. *--- Figure 2: Gender-specific event study (vertical layout) ---
. foreach g in 0 1 {
  2.     local lbl  = cond(`g' == 1, "Men", "Women")
  3.     local labl = cond(`g' == 1, "Men only", "Women only")
  4.     preserve
  5.     keep if male == `g'
  6.     levelsof year, local(years)
  7.     foreach yr of local years {
  8.         generate treat_yr_`yr' = treatment_ind * (year == `yr')
  9.     }
 10.     drop treat_yr_2017
 11.     capture drop treat_yr_2020
 12.     reg financial treat_yr_2013 treat_yr_2014 treat_yr_2015 treat_yr_2016 ///
>         treat_yr_2018 treat_yr_2019 treat_yr_2021 treat_yr_2022 treat_yr_2023 ///
>         treatment_ind post_tcja $controls i.year i.statefip ///
>         [pw = wt06], robust cluster(statefip)
 13.     coefplot, ///
