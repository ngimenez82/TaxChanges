  3.     reg `outcome' did_ind treatment_ind post_tcja duration ///
>         $controls i.year i.statefip ///
>         [pw = awbwt], robust cluster(statefip)
  4.     local action = cond(`first' == 1, "replace", "append")
  5.     outreg2 using "Results/Table5_WellBeing_FinancialOnly.xls", ///
>         ctitle("`lab' (Fin. Only)") ///
>         keep(did_ind treatment_ind post_tcja duration $controls) ///
>         addtext("Controls","Yes","State FE","Yes","Year FE","Yes") ///
>         bdec(3) se `action'
  6.     local first = 0
  7. }
